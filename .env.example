# Copy to .env on the server and fill in. Never commit .env.
# Make each password with:  openssl rand -base64 30

# The address staff open. Passkeys and sign-in cookies are tied to it, so set it before first use.
APP_ORIGIN=https://shiftbook.example.com

# Database owner (runs migrations and backups)
DB_OWNER_PASSWORD=

# The app's own database login (limited: row-level security applies)
API_DB_PASSWORD=

# Port on this server for a reverse proxy (only if you don't use the tunnel)
APP_PORT=8080

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels), if you use: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
